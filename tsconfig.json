{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "types": ["vite-plugin-pwa/client", "vite-plugin-pwa/info"],
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "public/models",
    ".cache",
    "node_modules",
    "playwright-report",
    "test-results",
    "Claude outputs"
  ]
}
