{
  "name": "vector",
  "version": "1.0.0-dev",
  "private": true,
  "description": "Vector — a calm study companion for the EASA PPL(A) theory.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "ci:lint": "biome ci --error-on-warnings .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "node scripts/check-budget.mjs",
    "check": "astro check --minimumFailingSeverity warning && biome ci --error-on-warnings . && vitest run --passWithNoTests && astro build && node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/svelte": "9.1.2",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vite-pwa/astro": "2.0.2",
    "astro": "7.4.8",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
