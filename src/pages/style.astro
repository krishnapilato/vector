---
import Button from '../components/Button.svelte'
import InlineAlert from '../components/InlineAlert.svelte'
import ProgressBar from '../components/ProgressBar.svelte'
import StatusBadge from '../components/StatusBadge.svelte'
import ControlsDemo from '../islands/style/ControlsDemo.svelte'
import DialogDemo from '../islands/style/DialogDemo.svelte'
import TimerDemo from '../islands/style/TimerDemo.svelte'
import Base from '../layouts/Base.astro'

const colors = [
  ['bg', 'Background'],
  ['surface', 'Surface'],
  ['surface-raised', 'Raised surface'],
  ['text', 'Text'],
  ['text-secondary', 'Secondary text'],
  ['border', 'Border'],
  ['border-strong', 'Control border'],
  ['rule', 'Rule'],
  ['accent', 'Accent'],
  ['accent-strong', 'Accent, pressed'],
  ['accent-soft', 'Accent, soft'],
  ['success', 'Success'],
  ['success-soft', 'Success, soft'],
  ['attention', 'Attention'],
  ['attention-soft', 'Attention, soft'],
] as const

const typeScale = [
  ['display', 'Timer', '24:12'],
  ['xl', 'Page title', 'Ready when you are.'],
  ['lg', 'Section title', 'Camera and detection'],
  ['md', 'Body', 'Frames are analysed on this device and dropped at once.'],
  ['sm', 'Secondary', 'Away for 60s — timer paused automatically.'],
  ['xs', 'Small print', 'Camera active'],
] as const

const spaces = [1, 2, 3, 4, 5, 6, 7, 8] as const
const radii = ['sm', 'md', 'lg'] as const
const shadows = ['sm', 'md', 'lg'] as const
---

<Base title="Style guide" noindex>
  <main class="page">
    <header class="intro">
      <a href={import.meta.env.BASE_URL}>← Back to Vector</a>
      <h1>Design system</h1>
      <p>
        Vector Studio: the shared foundations for a quieter workspace. Semantic colours, responsive type,
        consistent controls, and accessible states.
      </p>
    </header>

    <section aria-labelledby="colours">
      <h2 id="colours">Colour</h2>
      <ul class="swatches">
        {
          colors.map(([token, name]) => (
            <li>
              <span class="swatch" style={`background: var(--color-${token})`} />
              <span class="swatch-name">{name}</span>
              <code>--color-{token}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="type">
      <h2 id="type">Type</h2>
      <p class="lead">Instrument Sans for everything, with tabular digits so numbers never jump. Six sizes.</p>
      <dl class="type-scale">
        {
          typeScale.map(([size, role, sample]) => (
            <div>
              <dt>
                {role} <code>--text-{size}</code>
              </dt>
              <dd style={`font-size: var(--text-${size})`}>
                {sample}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="space">
      <h2 id="space">Space, shape, depth</h2>
      <div class="shape-grid">
        <ul class="spaces" aria-label="Spacing scale">
          {
            spaces.map((n) => (
              <li>
                <span class="space-bar" style={`width: var(--space-${n})`} />
                <code>--space-{n}</code>
              </li>
            ))
          }
        </ul>
        <ul class="tiles" aria-label="Radii">
          {
            radii.map((r) => (
              <li class="tile" style={`border-radius: var(--radius-${r})`}>
                <code>--radius-{r}</code>
              </li>
            ))
          }
        </ul>
        <ul class="tiles" aria-label="Shadows">
          {
            shadows.map((s) => (
              <li class="tile raised" style={`box-shadow: var(--shadow-${s})`}>
                <code>--shadow-{s}</code>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="lead">
        Motion: 120 ms and 200 ms with one easing curve, only when something changes state. Off
        entirely with reduced motion.
      </p>
    </section>

    <section aria-labelledby="buttons">
      <h2 id="buttons">Buttons</h2>
      <div class="row">
        <Button variant="primary" size="lg">Start</Button>
        <Button variant="primary">Save to logbook</Button>
        <Button>Keep going</Button>
        <Button variant="quiet">Why?</Button>
      </div>
      <div class="row">
        <Button variant="primary" disabled>Start</Button>
        <Button disabled>Keep going</Button>
        <Button variant="quiet" disabled>Why?</Button>
        <Button href="#buttons">Link styled as a button</Button>
      </div>
    </section>

    <section aria-labelledby="progress">
      <h2 id="progress">Progress</h2>
      <div class="stack">
        <ProgressBar value={18} max={30} label="Session" valueText="18 of 30 min" />
        <ProgressBar value={2} max={4} label="Segmented" valueText="2 of 4" segmented />
        <ProgressBar value={0} max={5} label="Empty" valueText="0 of 5" segmented />
      </div>
    </section>

    <section aria-labelledby="controls">
      <h2 id="controls">Inputs</h2>
      <ControlsDemo client:load />
    </section>

    <section aria-labelledby="session">
      <h2 id="session">Session</h2>
      <div class="row">
        <StatusBadge tone="active" label="Camera active · Local only" />
        <StatusBadge tone="paused" label="Camera paused" />
        <StatusBadge tone="off" label="Camera off" />
      </div>
      <TimerDemo client:load />
    </section>

    <section aria-labelledby="feedback">
      <h2 id="feedback">Alerts and dialogs</h2>
      <div class="stack">
        <InlineAlert title="Take 5 minutes to rest your eyes?">
          3 yawns and heavy eyelids in the last 10 minutes.
        </InlineAlert>
        <InlineAlert tone="success">Imported. 3 new sessions added; nothing was overwritten.</InlineAlert>
        <InlineAlert tone="attention">Away for 60s — timer paused automatically.</InlineAlert>
        <DialogDemo client:load />
      </div>
    </section>
  </main>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
    width: min(72rem, 100%);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-8);
  }

  @media (width >= 48rem) {
    .page {
      padding-inline: var(--space-6);
    }
  }

  section {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
    border-top: var(--border-thin) solid var(--color-border);
  }

  .intro {
    display: grid;
    gap: var(--space-3);
  }

  .intro p,
  .lead {
    color: var(--color-text-secondary);
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    gap: var(--space-1);
  }

  .swatch {
    height: 3.5rem;
    margin-bottom: var(--space-1);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .swatch-name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
  }

  .type-scale {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .type-scale div {
    display: grid;
    gap: var(--space-1);
  }

  .type-scale dt {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .type-scale dd {
    margin: 0;
    line-height: var(--leading-tight);
    max-width: var(--measure);
  }

  .shape-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-6);
  }

  .spaces,
  .tiles {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spaces li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .space-bar {
    height: 0.75rem;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .tile {
    display: grid;
    place-items: center;
    height: 4rem;
    border: var(--border-thin) solid var(--color-border-strong);
    background: var(--color-surface-raised);
  }

  .tile.raised {
    border-color: var(--color-border);
    border-radius: var(--radius-md);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }





  .stack {
    display: grid;
    gap: var(--space-5);
  }
</style>
