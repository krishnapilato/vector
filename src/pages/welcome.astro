---
import exercises from '../content/exercises.json'
import sim from '../content/sim-lessons.json'
import trebbi from '../content/trebbi.json'
import { parseContent } from '../core/model/content'
import Welcome from '../islands/onboarding/Welcome.svelte'
import App from '../layouts/App.astro'
import { copy } from '../lib/copy'

// Validated at build time: a wrong content file stops the build (PIANO-V3 §16).
const content = parseContent(trebbi, exercises, sim)
---

<App title={copy.welcome.title} focus>
  <Welcome client:only="svelte" content={content}>
    <p slot="fallback" role="status">{copy.app.loading}</p>
  </Welcome>
</App>
