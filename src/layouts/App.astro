---
import { copy } from '../lib/copy'
import Base from './Base.astro'

interface Props {
  title: string
  /** Hides the navigation, e.g. during a session or the first-run steps. */
  focus?: boolean
}

const { title, focus = false } = Astro.props
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname.replace(base, '/').replace(/\/$/, '') || '/'

const main = [
  { href: '', label: copy.nav.today, icon: 'today', match: '/' },
  { href: 'plan', label: copy.nav.plan, icon: 'plan', match: '/plan' },
  { href: 'logbook', label: copy.nav.logbook, icon: 'logbook', match: '/logbook' },
  { href: 'milestones', label: copy.nav.milestones, icon: 'milestones', match: '/milestones' },
] as const
const tools = [
  { href: 'materials', label: copy.nav.materials, icon: 'materials', match: '/materials' },
  { href: 'settings', label: copy.nav.settings, icon: 'settings', match: '/settings' },
] as const

const icons: Record<string, string> = {
  today:
    'M12 3v2M12 19v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M3 12h2M19 12h2M4.6 19.4 6 18M18 6l1.4-1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  plan: 'M4 6h16v14H4zM4 10h16M9 3v4M15 3v4',
  logbook: 'M6 3h11a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6zM6 3v18M10 8h5M10 12h5',
  milestones: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM14.5 9.5a1.5 1.5 0 1 0 0 .01',
  materials: 'M4 5a2 2 0 0 1 2-2h5v18H6a2 2 0 0 1-2-2zM13 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5z',
  settings: 'M4 7h10M18 7h2M4 17h4M12 17h8M14 5v4M8 15v4',
}
const isCurrent = (match: string) => (match === '/' ? path === '/' : path.startsWith(match))
---

<Base title={title}>
  <div class:list={['shell', { focus }]}>
    {
      !focus && (
        <nav class="nav" aria-label={copy.nav.main}>
          <a class="brand" href={base}>
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="10.5" fill="none" stroke="currentColor" stroke-width="2.5" />
              <circle cx="18.5" cy="13.5" r="3" fill="currentColor" />
            </svg>
            <span>{copy.app.name}</span>
          </a>
          <ul class="main">
            {main.map((item) => (
              <li>
                <a
                  href={`${base}${item.href}`}
                  aria-current={isCurrent(item.match) ? 'page' : undefined}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={icons[item.icon]} />
                  </svg>
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <ul class="tools">
            {tools.map((item) => (
              <li>
                <a
                  href={`${base}${item.href}`}
                  aria-current={isCurrent(item.match) ? 'page' : undefined}
                  aria-label={item.label}
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d={icons[item.icon]} />
                  </svg>
                  <span class="tool-label">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <main class="content" id="main">
      <div class="app-error" id="error-generic" role="alert" hidden>{copy.errors.generic}</div>
      <div class="app-error" id="error-quota" role="alert" hidden>{copy.errors.quota}</div>
      <div class="app-error" id="error-upgrade" role="alert" hidden>{copy.errors.upgrade}</div>
      <slot />
    </main>
  </div>
</Base>

<script>
  import { db } from '../lib/db'
  import { startSyncRunner } from '../lib/sync-runner'

  function show(id: string) {
    const el = document.getElementById(id)
    if (el) el.hidden = false
  }

  window.addEventListener('unhandledrejection', (event) => {
    const name = (event.reason as { name?: string } | null)?.name ?? ''
    show(name.includes('Quota') ? 'error-quota' : 'error-generic')
  })
  db.on('versionchange', () => {
    db.close()
    show('error-upgrade')
    return false
  })
  void startSyncRunner()
</script>

<style>
  .shell {
    min-height: 100dvh;
  }

  .nav {
    position: fixed;
    z-index: 10;
    inset: auto 0 0 0;
    display: flex;
    align-items: stretch;
    border-top: var(--border-thin) solid var(--color-border);
    background: var(--color-surface-raised);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .brand,
  .tools {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .nav a {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: 3.5rem;
    padding: var(--space-1);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .content {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    width: min(46rem, 100%);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) calc(5.5rem + env(safe-area-inset-bottom));
  }

  .focus .content {
    padding-bottom: var(--space-7);
  }

  /* Phones: Materials and Settings sit at the top right. */
  @media (width < 56rem) {
    .tools {
      position: fixed;
      top: 0;
      right: 0;
      display: flex;
      padding: var(--space-2);
    }

    .tools a {
      min-width: var(--target-min);
      min-height: var(--target-min);
    }

    .tool-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .content {
      padding-top: var(--space-7);
    }
  }

  /* Computers: a calm sidebar on the left. */
  @media (width >= 56rem) {
    .nav {
      inset: 0 auto 0 0;
      width: 14rem;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-3);
      border-top: 0;
      border-right: var(--border-thin) solid var(--color-border);
      background: var(--color-surface);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      color: var(--color-text);
      font-weight: var(--font-weight-semibold);
      font-size: var(--text-lg);
      text-decoration: none;
    }

    .brand svg {
      width: 1.75rem;
      height: 1.75rem;
      color: var(--color-accent);
    }

    .main,
    .tools {
      display: grid;
      grid-template-columns: none;
      gap: var(--space-1);
      flex: none;
    }

    .tools {
      margin-top: auto;
    }

    .nav a {
      display: flex;
      justify-content: flex-start;
      gap: var(--space-3);
      min-height: var(--target-min);
      padding: 0 var(--space-3);
      font-size: var(--text-sm);
    }

    .nav a:hover {
      background: var(--color-accent-soft);
      color: var(--color-text);
    }

    .nav a[aria-current='page'] {
      background: var(--color-accent-soft);
      color: var(--color-accent-strong);
    }

    .shell:not(.focus) {
      padding-left: 14rem;
    }

    .content {
      padding: var(--space-7) var(--space-6) var(--space-8);
    }
  }

  .app-error {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-attention-soft);
    color: var(--color-text);
    font-size: var(--text-sm);
  }
</style>
