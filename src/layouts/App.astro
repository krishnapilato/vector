---
/**
 * Responsive workspace: desktop sidebar, mobile dock, one headline per page.
 * Everything else lives in the page's island.
 */
import { copy } from '../lib/copy'
import Base from './Base.astro'

interface Props {
  title: string
  /** Centres a single panel in the window (the Focus page). */
  centered?: boolean
}

const { title, centered = false } = Astro.props
const base = import.meta.env.BASE_URL
const path = Astro.url.pathname.replace(base, '/').replace(/\/$/, '') || '/'

/** Icon navigation keeps accessible names and keyboard-visible tooltips. */
const links = [
  {
    href: '',
    label: copy.nav.focus,
    match: '/',
    icon: 'M12 21a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM12 9v4l2.5 1.5M10 2.5h4',
  },
  {
    href: 'logbook',
    label: copy.nav.logbook,
    match: '/logbook',
    icon: 'M6.5 3H18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6.5A1.5 1.5 0 0 1 5 19.5v-15A1.5 1.5 0 0 1 6.5 3ZM9 8h6M9 12h6M9 16h3',
  },
  {
    href: 'settings',
    label: copy.nav.settings,
    match: '/settings',
    icon: 'M4 7h9M17 7h3M4 17h3M11 17h9M15 5v4M9 15v4',
  },
]
---

<Base title={title}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell">
  <header class:list={['header']}>
    <a class="brand" href={base}>
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="10.5" fill="none" stroke="currentColor" stroke-width="2.5"></circle>
        <circle cx="18.5" cy="13.5" r="3" fill="currentColor"></circle>
      </svg>
      <span>{copy.app.name}</span>
    </a>
    <nav aria-label={copy.nav.main}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={`${base}${link.href}`}
                aria-label={link.label}
                aria-current={path === link.match ? 'page' : undefined}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={link.icon} />
                </svg>
                <span class="nav-label" aria-hidden="true">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="security" href={`${base}settings#privacy`} aria-label="Privacy and data security">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 4 4 7 8 9 4-2 8-5 8-9V6l-8-3Zm-4 9 3 3 5-6" /></svg>
      <span class="nav-label" aria-hidden="true">Private by design. Local by default.</span>
    </a>
  </header>
  <main class="scroller" id="main" tabindex="-1">
    <div class:list={['content', { centered }]}>
      <div class="app-error" id="error-generic" role="alert" hidden>{copy.errors.generic}</div>
      <div class="app-error" id="error-quota" role="alert" hidden>{copy.errors.quota}</div>
      <slot />
    </div>
  </main>
  </div>
</Base>

<script>
  // A last safety net: an unexpected error shows a calm line instead of failing silently.
  window.addEventListener('unhandledrejection', (event) => {
    const name = (event.reason as { name?: string } | null)?.name ?? ''
    const el = document.getElementById(name.includes('Quota') ? 'error-quota' : 'error-generic')
    if (el) el.hidden = false
  })
</script>

<style>
  .skip-link { position: fixed; top: -5rem; left: 1rem; z-index: 30; padding: 0.75rem 1rem; background: var(--color-surface-raised); border-radius: var(--radius-sm); }
  .skip-link:focus { top: 1rem; }
  .shell { min-height: 100dvh; }
  .header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding: var(--space-4) var(--space-5); background: var(--color-sidebar); color: var(--color-on-accent); }
  .brand { display: flex; align-items: center; gap: var(--space-3); min-height: var(--target-min); color: inherit; font-size: 1.375rem; font-weight: 600; letter-spacing: -0.045em; text-decoration: none; }
  .brand svg { width: 2rem; height: 2rem; color: #d6d7db; }
  ul { display: flex; gap: var(--space-2); padding: 0; margin: 0; list-style: none; }
  nav a { display: flex; align-items: center; gap: var(--space-3); min-height: var(--target-min); padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm); color: #c9cbd1; font-size: var(--text-sm); text-decoration: none; transition: background-color var(--duration-fast) var(--ease), color var(--duration-fast) var(--ease); }
  nav a:hover { color: white; background: #ffffff0d; }
  nav a[aria-current='page'] { background: #ffffff12; color: #ffffff; box-shadow: inset 3px 0 #d6d7db; }
  nav svg { width: 1.25rem; height: 1.25rem; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .security { position: relative; display: grid; place-items: center; min-width: var(--target-min); min-height: var(--target-min); color: #c9cbd1; border-radius: var(--radius-sm); }
  .security svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .nav-label { position: absolute; left: calc(100% + 0.75rem); top: 50%; z-index: 20; transform: translateY(-50%); width: max-content; max-width: 16rem; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); background: var(--color-sidebar); color: var(--color-on-accent); font-size: var(--text-xs); box-shadow: var(--shadow-md); visibility: hidden; opacity: 0; pointer-events: none; transition: opacity var(--duration-fast) var(--ease); }
  a:hover > .nav-label, a:focus-visible > .nav-label { visibility: visible; opacity: 1; }
  nav a { position: relative; justify-content: center; width: var(--target-min); padding: var(--space-3); }
  .content { display: grid; align-content: start; gap: var(--space-6); width: min(var(--layout-page), 100%); margin: 0 auto; padding: var(--space-7) var(--space-5) var(--space-8); }
  .content.centered { width: min(var(--layout-wide), 100%); }
  .app-error { padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-attention-soft); font-size: var(--text-sm); }
  @media (width >= 64rem) {
    .shell { display: grid; grid-template-columns: 5rem minmax(0, 1fr); height: 100dvh; overflow: hidden; }
    .header { height: 100%; flex-direction: column; align-items: center; justify-content: start; padding: var(--space-5) var(--space-3); }
    .brand { justify-content: center; width: var(--target-min); margin-bottom: var(--space-6); }
    .brand > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    ul { flex-direction: column; }
    .security { margin-top: auto; }
    .scroller { min-width: 0; overflow: auto; overscroll-behavior: contain; }
    .content.centered { min-height: 100%; align-content: center; padding-block: var(--space-6); }
  }
  @media (width < 64rem) {
    .header { padding: var(--space-3) var(--space-4); }
    nav { position: fixed; bottom: calc(1rem + env(safe-area-inset-bottom)); left: 50%; z-index: 10; transform: translateX(-50%); padding: 5px; border: 1px solid #ffffff20; border-radius: var(--radius-md); background: var(--color-sidebar); box-shadow: var(--shadow-lg); }
    nav a { width: 3rem; height: 3rem; }
    nav a[aria-current='page'] { box-shadow: none; }
    nav .nav-label { left: 50%; top: auto; bottom: calc(100% + 1rem); transform: translateX(-50%); }
    .security .nav-label { left: auto; right: 0; top: calc(100% + 0.5rem); transform: none; }
    .content { padding-top: var(--space-6); padding-bottom: calc(7rem + env(safe-area-inset-bottom)); }
  }
</style>
