---
import { pwaInfo } from 'virtual:pwa-info'
import '../styles/base.css'

interface Props {
  title: string
  description?: string
  noindex?: boolean
}

const {
  title,
  description = 'Privacy-first focus sessions. The camera stays on your device.',
  noindex = false,
} = Astro.props
const base = import.meta.env.BASE_URL
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f6f7" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>{title === 'Vector' ? title : `${title} · Vector`}</title>
  </head>
  <body>
    <slot />
    <script>
      // Production builds only (the dev server has no service worker). It updates itself
      // (skipWaiting + clientsClaim), so no extra library is needed. Offline is a bonus:
      // a failed registration must never bother the learner.
      if (import.meta.env.PROD && 'serviceWorker' in navigator)
        navigator.serviceWorker
          .register(`${import.meta.env.BASE_URL}sw.js`, { scope: import.meta.env.BASE_URL })
          .catch(() => undefined)
    </script>
  </body>
</html>
